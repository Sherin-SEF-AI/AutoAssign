# BluRabbit Dispatch configuration. Every value is read from the environment and validated at
# startup; the process refuses to start on a missing or malformed value and names it.
# Copy to .env for docker compose. Values without a default are required.

# --- Infrastructure -----------------------------------------------------------------------
# DATABASE_URL and REDIS_URL are set by docker-compose.yml for containers; set them for local runs.
DATABASE_URL=postgresql+asyncpg://dispatch:dispatch@localhost:5432/dispatch
REDIS_URL=redis://localhost:6379/0
# At least 32 characters. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_TTL_HOURS=12
# Seeds the first admin user on first start.
ADMIN_EMAIL=admin@blurabbit.local
ADMIN_PASSWORD=change-me-please
# Comma separated keys accepted on /events/* and /pings (X-API-Key header).
SERVICE_API_KEYS=change-me-service-key
# Origin of the web app, for CORS. Comma separated for several.
WEB_ORIGIN=http://localhost:5173
ENVIRONMENT=development

# --- Data source ---------------------------------------------------------------------------
# synthetic (default) or http. Switching to http needs only the four UPSTREAM_* values.
DATA_SOURCE=synthetic
SYNTHETIC_SEED=42
UPSTREAM_USERAPP_URL=
UPSTREAM_DRIVERAPP_URL=
UPSTREAM_ADMIN_URL=
UPSTREAM_API_KEY=
UPSTREAM_TIMEOUT_S=10

# --- HERE (Routing v8, Matrix Routing v8, vector tiles) -----------------------------------
# Backend only. Never exposed to the browser: map tiles are proxied with the key injected.
HERE_API_KEY=
HERE_ENABLED=true
HERE_ROUTING_DAILY_CAP=600
HERE_MATRIX_DAILY_CAP=40
HERE_MATRIX_ELEMENTS_DAILY_CAP=2000
# Days HERE derived durations may be kept. Purged daily at 03:00 IST. Maximum 30.
HERE_RETENTION_DAYS=30

# --- OSRM (optional, compose profile osrm) -------------------------------------------------
# e.g. http://osrm:5000 inside compose.
OSRM_URL=
OSRM_ENABLED=true

# --- Provider HTTP hygiene -----------------------------------------------------------------
HTTP_TIMEOUT_S=5
HTTP_RETRIES=3
HTTP_BACKOFF_BASE_S=0.5
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_S=600

# --- ETA ------------------------------------------------------------------------------------
# Cache hits younger than this are served as is.
CACHE_FRESH_S=86400
HOT_CACHE_TTL_S=21600
# Quantile factors used before the first calibration.
FACTOR_R50_DEFAULT=1.00
FACTOR_R80_DEFAULT=1.15
FACTOR_R90_DEFAULT=1.30
CIRCUITY=1.35
# Speed profile (IST start minute, km/h) for the fallback estimator.
SPEED_PROFILE_JSON='[{"start_min":0,"kmh":38},{"start_min":360,"kmh":28},{"start_min":420,"kmh":15},{"start_min":600,"kmh":22},{"start_min":1020,"kmh":13},{"start_min":1260,"kmh":30}]'
CALIBRATION_MIN_N=30
ZONE_CLUSTERS_K=8

# --- Solver --------------------------------------------------------------------------------
SOLVER_TIME_LIMIT_S=60
INCREMENTAL_TIME_LIMIT_S=20
# Deterministic stopping rule: the search stops after this many solutions (time limit is a safety net).
SOLVER_SOLUTION_LIMIT=3000
INCREMENTAL_SOLUTION_LIMIT=1000
DROP_PENALTY_S=100000
BUFFER_FIXED_S=900
BUFFER_PCT=0.10
BUFFER_MIN_S=300
EARLY_ARRIVAL_S=600
MAX_GAP_S=14400
MAX_DEADHEAD_KM=25
MAX_TRIPS_PER_DRIVER=5
FAIRNESS_COST_S=1800
DEADHEAD_M_WEIGHT=0.02
P_AUX_W=1200
# Planning range caps (km per day) and rolling consumption (Wh per km) per vehicle model.
RANGE_CAPS_JSON='{"tigor_ev":140,"ec3":165,"windsor":220,"zs_ev":245}'
E_ROLL_JSON='{"tigor_ev":137,"ec3":128,"windsor":123,"zs_ev":149}'
HANDLING_S=240

# --- Monitoring and repair -----------------------------------------------------------------
RISK_THRESHOLD_S=600
LATE_TOLERANCE_S=300
MONITOR_INTERVAL_S=300
FLOAT_HORIZON_S=5400
ABSENT_GRACE_S=900

# --- Notifications (optional) --------------------------------------------------------------
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# --- Simulator (compose profile sim) -------------------------------------------------------
# Service date to simulate (YYYY-MM-DD). Defaults to today IST.
SIM_DATE=
SIM_SPEED=60
SIM_PING_INTERVAL_S=30

# --- Misc -------------------------------------------------------------------------------------
LOG_LEVEL=INFO
TZ_DISPLAY=Asia/Kolkata
PINGS_MAX_BATCH=5000
PINGS_MAX_BODY_BYTES=2000000
LOGIN_RATE_PER_MINUTE=5
